{
  "$schema": "https://github.com/wesleysimplicio/hermes-turbo-agent/blob/main/docs/agents/hermes-meta-schema.json",
  "version": "1.0",
  "comment": "Containment contract enforced by agent.file_safety. Inspired by .starter-meta.json from wesleysimplicio/llm-project-mapper.",
  "managed_paths": [
    "agent/**",
    "hermes_cli/**",
    "scripts/**",
    "tests/**",
    "docs/**",
    "prompts/**",
    ".github/workflows/**",
    "CHANGELOG.md",
    "MODIFICATIONS.md",
    "PROGRESS.md",
    "GOAL_RESULT.md"
  ],
  "read_only_globs": [
    ".git/**",
    ".upstream-sync/**",
    "uv.lock",
    "package-lock.json",
    "*.lock",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    ".catalog/hamt.json",
    ".receipts/**",
    "tota_agent_benchmark_report.pdf"
  ],
  "init_must_merge": [
    "CLAUDE.md",
    "AGENTS.md",
    ".github/copilot-instructions.md",
    ".codex/AGENTS.md"
  ],
  "init_must_ask": [
    "PRD.md",
    "pyproject.toml",
    "Dockerfile",
    "package.json",
    "flake.nix",
    "setup-hermes.sh"
  ],
  "policy": {
    "on_read_only_violation": "block",
    "on_init_must_merge": "warn",
    "on_init_must_ask": "ask"
  }
}
